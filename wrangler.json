{
 "name": "fangorn-music",
 "main": "node_modules/@fangorn-network/westmarch/site/worker.js",
 "compatibility_date": "2025-09-15",
 "compatibility_flags": ["nodejs_compat"],
 "assets": { "directory": ".ship/site", "binding": "ASSETS", "run_worker_first": ["/.well-known/*", "/openapi.json"] },
 "r2_buckets": [{ "binding": "VIEW", "bucket_name": "fangorn-music-view","preview_bucket_name": "fangorn-music-view" }],
 "ai": { "binding": "AI" },
 "triggers": { "crons": ["*/5 * * * *"] },
 "limits": { "cpu_ms": 300000 },
 "alias": { "@huggingface/transformers": "./node_modules/@fangorn-network/westmarch/site/no-model.js" },
 "vars": { "IPFS_GATEWAY": "https://green-reasonable-heron-957.mypinata.cloud"},
 "observability": { "enabled": true }
}
