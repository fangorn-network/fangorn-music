{
 "app": "fangorn-music",
 "name": "Fangorn Music",
 "description": "The 50,000 most-played tracks on Audius, searchable by vibe: describe a moment or a mood and get tracks to play.",
 "network": "baseSepolia",
 "site": {
  "project": "fangorn-music",
  "url": "https://music.fangorn.network",
  "examples": ["Driving to the beach", "Girls night out", "Party at my house"]
 },
 "tags": ["music", "audius"],
 "types": {
  "fangorn-music.track.v1": {
   "description": "One track on Audius: its title and artist, genre, mood, tags, tempo and key, how often it is played, and a link to play it.",
   "role_map": {
    "identity": "track_id",
    "title": "title",
    "subtitle": "artist",
    "tags": ["genre", "mood", "tags"],
    "text": ["text"],
    "measures": ["plays", "bpm", "duration"],
    "temporal": "release_date"
   },
   "presentation": {
    "types": { "fangorn-music.track.v1": { "singular": "track", "plural": "tracks" } },
    "facets": ["genre", "mood"],
    "externalUrl": { "fangorn-music.track.v1": "{url}" }
   }
  }
 },
 "sources": [
  { "namespace": "audius-tracks",
    "command": ["${PYTHON:-.venv/bin/python}", "sources/audius_dump.py",
                "--output-dir", ".ship/stage/audius-tracks", "--cache-dir", ".ship/cache/audius-tracks"] }
 ]
}
